# see_self 环境变量示例。复制为 .env 后按需修改；.env 不会提交到 git。
#
# ── 数据库连接串 DATABASE_URL ──────────────────────────────────────────────
# 默认不配置时使用本地 SQLite（data/seeself.db），零依赖即可运行。
# DATABASE_URL=sqlite:///data/seeself.db
#
# 切换到 MySQL（需先 uv sync --extra mysql，并用 scripts/init_mysql.py 初始化库表）：
# DATABASE_URL=mysql+pymysql://用户名:密码@主机:端口/see_life?charset=utf8mb4
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:13306/see_life?charset=utf8mb4
